terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  backend "s3" {
    bucket       = "taxbilling-tfstate-419715283045"
    key          = "ci/terraform.tfstate" # its own state, separate from dev
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = "us-east-1"
  default_tags {
    tags = { Project = "tax-billing", ManagedBy = "terraform", Component = "ci" }
  }
}
